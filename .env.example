# Arbitrage Platform — local dev env example
# Copy to .env and fill in real values. Never commit .env.

# Server
ARBITRAGE_HOST=0.0.0.0
ARBITRAGE_PORT=8080
ARBITRAGE_MODE=debug

# PostgreSQL
ARBITRAGE_DB_HOST=localhost
ARBITRAGE_DB_PORT=5432
ARBITRAGE_DB_USER=arbitrage
ARBITRAGE_DB_PASSWORD=change_me_db_password
ARBITRAGE_DB_NAME=arbitrage
ARBITRAGE_DB_SSLMODE=disable
ARBITRAGE_DB_MAX_OPEN_CONNS=25
ARBITRAGE_DB_MAX_IDLE_CONNS=25
ARBITRAGE_DB_CONN_MAX_LIFETIME=5m

# Auth / JWT
ARBITRAGE_JWT_SECRET=change_me_at_least_32_chars_long_secret
ARBITRAGE_JWT_EXPIRATION=15m
ARBITRAGE_REFRESH_EXPIRATION=168h
ARBITRAGE_ADMIN_EMAIL=admin@arbitrage.local
ARBITRAGE_ADMIN_PASSWORD=change_me_admin_password
ARBITRAGE_SIWE_DOMAIN=localhost
ARBITRAGE_SIWE_NONCE_TTL=5m
ARBITRAGE_SIWE_CHAINS=1,42161,10,137,8453

# Logging
ARBITRAGE_LOG_LEVEL=info
ARBITRAGE_LOG_FORMAT=json

# WebSocket buffers
ARBITRAGE_WS_READ_BUFFER=1024
ARBITRAGE_WS_WRITE_BUFFER=1024

# CORS
ARBITRAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # bot username WITHOUT leading @ (e.g. my_arbitrage_bot)
APP_PUBLIC_URL=http://localhost:3000

# Logo storage
ARBITRAGE_LOGO_DIR=./data/logos
ARBITRAGE_LOGO_REFRESH_DAYS=30
ARBITRAGE_LOGO_NEGATIVE_DAYS=7
ARBITRAGE_LOGO_WORKERS=2
LOGO_DEV_SECRET_KEY=
