# ═══════════════════════════════════════════════════════════════
# Arbitrage Platform — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Server
ARBITRAGE_HOST=0.0.0.0
ARBITRAGE_PORT=8080
ARBITRAGE_MODE=debug

# Database
ARBITRAGE_DB_HOST=localhost
ARBITRAGE_DB_PORT=5432
ARBITRAGE_DB_USER=arbitrage
ARBITRAGE_DB_PASSWORD=your_password_here
ARBITRAGE_DB_NAME=arbitrage
ARBITRAGE_DB_SSLMODE=disable
ARBITRAGE_DB_MAX_OPEN_CONNS=25
ARBITRAGE_DB_MAX_IDLE_CONNS=25
ARBITRAGE_DB_CONN_MAX_LIFETIME=5m

# Auth
ARBITRAGE_JWT_SECRET=your_super_secret_key_here
ARBITRAGE_JWT_EXPIRATION=15m
ARBITRAGE_REFRESH_EXPIRATION=168h
ARBITRAGE_SIWE_DOMAIN=localhost              # Change to your domain in production
ARBITRAGE_SIWE_NONCE_TTL=5m
ARBITRAGE_SIWE_CHAINS=1,42161,10,137,8453

# Logging
ARBITRAGE_LOG_LEVEL=info
ARBITRAGE_LOG_FORMAT=json

# WebSocket
ARBITRAGE_WS_READ_BUFFER=1024
ARBITRAGE_WS_WRITE_BUFFER=1024

# CORS (comma-separated origins, * for all)
ARBITRAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
